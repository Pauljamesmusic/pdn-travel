# Copy to .env and change the secrets before deploying anywhere public.
PORT=3000
NODE_ENV=development

# SQLite for local development. Switch provider in prisma/schema.prisma to "postgresql"
# and point this at a Postgres URL for production, or use an absolute file path on a
# persistent disk (e.g. "file:/data/prod.db") when deploying with SQLite.
DATABASE_URL="file:./dev.db"

# Where uploaded images are written/served from. Defaults to ./uploads next to the app.
# Point this at a persistent disk mount in production (e.g. "/data/uploads").
UPLOADS_DIR=

# Long random string — `openssl rand -hex 48`
JWT_SECRET="change-me"

# Origin(s) of the public website allowed to call write endpoints (comma separated)
WEB_ORIGIN="http://localhost:5173"

# Set to true when served over HTTPS
COOKIE_SECURE=false

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@pdntravel.com"
ADMIN_PASSWORD="change-me-to-a-long-password"
ADMIN_NAME="PDN Admin"
